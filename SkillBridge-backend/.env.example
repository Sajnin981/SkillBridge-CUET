# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.
NODE_ENV=development
PORT=8080

# MongoDB Atlas connection string (mongodb+srv://...). URL-encode special characters in the password.
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Deployed frontend origin(s), no trailing slash. Comma-separate multiple, e.g.
# https://skillbridge.vercel.app,https://skillbridge.example.com
CLIENT_URL=http://localhost:5173

# Optional (default 5). Vercel limits request bodies to ~4.5 MB.
MAX_FILE_SIZE_MB=4